# Copy to .env.linux and fill in the local settings. This file is read by every Linux package run.
# Linux packages are built locally: they are unsigned, publish to no feed, and embed no policy service,
# so only the shared settings below are accepted here.

# Reverse-DNS application identifier embedded in the package and its protocol handler.
DSH_DESKTOP_APP_ID=com.deepseek.harness

# Registry the bundled dsh runtime installs plugins from. Defaults to https://registry.npmjs.org/
# when absent; an accessible mirror shortens repeated local packages.
DSH_DESKTOP_NPM_REGISTRY=https://registry.npmjs.org/
